{
  "name": "dsots-gui",
  "private": true,
  "version": "1.0.0",
  "description": "DSOTS Melee thumbnail creator",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Christopher Solanilla",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:linux": "npm run build && electron-builder --linux AppImage",
    "electron:win": "npm run build && electron-builder --win portable",
    "electron:win-installer": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "express": "^5.2.1",
    "get-port": "^7.2.0",
    "html-to-image": "^1.11.13",
    "vue": "^3.5.34",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "concurrently": "^10.0.3",
    "electron": "^42.4.0",
    "electron-builder": "^26.5.0",
    "sass-embedded": "^1.100.0",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.dsots.thumbnailcreator",
    "productName": "DSOTS Thumbnail Creator",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "DSOTS-Thumbnail-Creator-Portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "DSOTS-Thumbnail-Creator-Setup.exe"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "artifactName": "DSOTS-Thumbnail-Creator.AppImage"
    }
  }
}
